(library
  (name kissforth)
  (libraries
    sexplib
    ppx_sexp_conv)
  (preprocess
    (pps ppx_sexp_conv))
  (foreign_stubs
    (language c)
    (names name_stubs))
  (foreign_archives name))

(data_only_dirs csrc)
(rule
  (deps (source_tree csrc))
  (targets libname.a)
  (action (no-infer (progn
    (chdir csrc (run just))
    (copy csrc/libname.a libname.a)))))
