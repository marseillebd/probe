cabal-version:      3.0
name:               probe
version:            0
synopsis:           prope package, DO NOT PUBLISH
-- description:
license:            BSD-3-Clause
license-file:       LICENSE
author:             Marseille Bouchard Demko
maintainer:         marseillebd@proton.me
-- copyright:
build-type:         Simple
extra-doc-files:    CHANGELOG.md
-- extra-source-files:

common prelude
    ghc-options:
      -Wall -fwarn-unticked-promoted-constructors
    build-depends:
      , array
      , base
      , bytestring
      , containers
      , directory
      , filepath
      , mtl
      , text
    default-language: Haskell2010

executable probe
    import: prelude
    main-is: Main.hs
    other-modules: Util
    build-depends:
      -- optparse-applicative
    hs-source-dirs: .
